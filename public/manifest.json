{
  "name": "Fotoğraf Kutusu",
  "short_name": "Fotoğraf Kutusu",
  "description": "Profesyonel fotoğraf baskı ve çerçeveleme hizmetleri",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#667eea",
  "orientation": "portrait-primary",
  "scope": "/",
  "icons": [
    { "src": "/vite.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/vite.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "categories": ["shopping", "photography"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Sipariş Ver",
      "short_name": "Sipariş",
      "description": "Yeni sipariş oluştur",
      "url": "/product-upload",
      "icons": [{ "src": "/vite.svg", "sizes": "96x96", "type": "image/svg+xml" }]
    },
    {
      "name": "Sepetim",
      "short_name": "Sepet",
      "description": "Sepetimi görüntüle",
      "url": "/cart",
      "icons": [{ "src": "/vite.svg", "sizes": "96x96", "type": "image/svg+xml" }]
    }
  ],
  "share_target": {
    "action": "/product-upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "photos", "accept": ["image/*"] }]
    }
  }
